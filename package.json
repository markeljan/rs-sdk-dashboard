{
  "name": "rs-sdk-dashboard",
  "version": "0.1.0",
  "description": "Web dashboard for rs-sdk bot accounts: live game view, remote control from your phone, stats and XP tracking. Run it locally or use the hosted service.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "rs-dashboard": "app/cli.ts"
  },
  "files": [
    "app",
    "tools",
    "sdk",
    "server",
    "scripts",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "start": "bun app/cli.ts start",
    "dev": "bun --watch app/cli.ts start",
    "postinstall": "cd server/webclient && bun install --production --ignore-scripts",
    "test": "bun test app tools/dashboard",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json && bun test app",
    "sync": "bun scripts/sync-from-rs-sdk.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "keywords": [
    "rs-sdk",
    "runescape",
    "bot",
    "dashboard",
    "agents"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/markeljan/rs-sdk-dashboard.git"
  },
  "dependencies": {
    "open": "^11.0.0",
    "puppeteer": "^24.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
