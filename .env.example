# ---------------------------------------------------------------- common
# local (default): one user, runs on your machine.  hosted: sign-ups, many users (what the public service runs).
RSD_MODE=local
PORT=4747
# Where the database, encryption key and browser profiles live (default ~/.rs-dashboard, /data in Docker).
# RSD_DATA_DIR=
# Default game server for new accounts - same value as SERVER= in rs-sdk's bot.env.
RSD_SERVER=rs-sdk-demo.fly.dev

# ---------------------------------------------------------------- local mode: onboarding without the UI
# Password for the web UI. Recommended if other people can reach this machine.
# RSD_PASSWORD=
# Accounts: "name:password[@server][!]", comma separated. A trailing ! runs the game client on the dashboard.
# RSD_ACCOUNTS=mybot:secret, alt2:pw@localhost!
# Your rs-sdk checkout: imports every bots/<name>/bot.env and shows each bot's newest *.log.
# RS_SDK_DIR=/path/to/rs-sdk
# A JSON file of accounts: {"accounts":[{"name":"mybot","password":"...","runClient":true}]} (rs-sdk accounts.json works too).
# RSD_ACCOUNTS_FILE=./accounts.json
# Quitting the dashboard stops the game clients it ran; 1 keeps them running (the next start reattaches).
# RSD_KEEP_CLIENTS=0

# ---------------------------------------------------------------- the dashboard itself (passed to each dashboard process)
# FPS=30                       # default stream rate (Settings -> Stream FPS overrides)
# QUALITY=0.9                  # default stream quality 0-1 (Settings -> Stream quality overrides)
# IDLE_FPS=5                   # render rate of unwatched game clients (bots unaffected)
# PUPPETEER_EXECUTABLE_PATH=   # Chrome for game clients (default: the one puppeteer downloaded)

# ---------------------------------------------------------------- hosted mode
# RSD_PUBLIC_URL=https://dash.example.com
# RSD_SECRET=long-random-string        # encrypts stored game passwords; keep it stable
# RSD_ADMIN_EMAIL=you@example.com
# RSD_SIGNUPS=true
# RSD_MAX_ACCOUNTS=20                  # per user
# RSD_MAX_CLIENTS_PER_USER=3
# RSD_MAX_CLIENTS=14                   # whole server (each client is a headless Chrome, ~250 MB)
# RSD_IDLE_STOP_MIN=30                 # stop a user's dashboard process after 30 idle minutes (not if it runs game clients)
